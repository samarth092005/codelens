# ==============================================================================
# CodeLens Environment Variables
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="CodeLens API"
VERSION=0.1.0
API_V1_STR=/api/v1

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens_password
POSTGRES_DB=codelens

# Direct Database URL (Optional override)
# Used by SQLAlchemy and Alembic
DATABASE_URL=postgresql+psycopg://codelens:codelens_password@localhost:5432/codelens
